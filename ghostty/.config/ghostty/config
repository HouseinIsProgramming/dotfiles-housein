font-size = 13

# font-family = IosevkaTerm Nerd Font Mono
# font-family = FiraCode Nerd Font
font-family = CommitMono Nerd Font
# font-family = GeistMono Nerd Font
# font-family = JetBrainsMono Nerd Font
#

font-feature =  -calt, -liga, -dliga 
adjust-cell-height = 15%

# Ghostty only hosts herdr: drop every default binding (tabs, splits, new
# windows) so keys reach herdr, then add back the few Ghostty still owns.
keybind = clear
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+q=quit
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size
keybind = cmd+ctrl+f=toggle_fullscreen
keybind = cmd+g>x=close_surface
keybind = cmd+g>r=reload_config
# cmd+1..9 -> alt+1..9 (herdr switch_tab); ESC+digit is how a terminal sends alt+digit
keybind = cmd+1=text:\x1b1
keybind = cmd+2=text:\x1b2
keybind = cmd+3=text:\x1b3
keybind = cmd+4=text:\x1b4
keybind = cmd+5=text:\x1b5
keybind = cmd+6=text:\x1b6
keybind = cmd+7=text:\x1b7
keybind = cmd+8=text:\x1b8
keybind = cmd+9=text:\x1b9

# theme = light:Arthur, dark:Hybrid
theme = Everforest Dark Hard
# theme = Iceberg Dark
# background = 101013

mouse-hide-while-typing
window-save-state = "always"
confirm-close-surface = false
quit-after-last-window-closed = true

macos-option-as-alt = left

window-padding-color = extend-always
window-decoration = none
window-padding-balance = true

