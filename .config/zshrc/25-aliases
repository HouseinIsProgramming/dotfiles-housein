# cpr - cd to project root (uses zoxide)
cpr() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    [[ -e "$dir/.git" ]] && { j "$dir"; return 0; }
    dir="${dir:h}"
  done
  echo "No project root found"
  return 1
}
